<h3>Brick Weave</h3>
<form id="brickWeaveSettingsForm" class="form-horizontal">
    <div class="control-group">
        <label class="control-label" for="brickWeaveStyle">Style</label>
        <div class="controls">
            <select id="brickWeaveStyle">
                <option value="50-50" selected>50-50</option>
                <option value="Percent">Percent</option>
                <option value="Chevron">Chevron</option>
            </select>
        </div>
    </div>

    <div id="brickWeavePercentControl" class="control-group" style="display:none;">
        <label class="control-label" for="brickWeavePercent">Percent</label>
        <div class="controls">
            <input id="brickWeavePercent" type="number" step="0.1" min="0" value="50">
        </div>
    </div>

    <div id="brickWeaveRepeatsControl" class="control-group" style="display:none;">
        <label class="control-label" for="brickWeaveRepeats">Repeats</label>
        <div class="controls">
            <input id="brickWeaveRepeats" type="number" step="1" min="1" value="4">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="brickWeaveDivisions">Number of divisions</label>
        <div class="controls">
            <input id="brickWeaveDivisions" type="number" step="1" min="1" value="12">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="brickWeaveTotalDepth">Total Depth</label>
        <div class="controls">
            <input id="brickWeaveTotalDepth" type="number" step="0.1" min="0" value="3">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="brickWeaveDepthIncrement">Depth Increment</label>
        <div class="controls">
            <input id="brickWeaveDepthIncrement" type="number" step="0.1" min="0" value="1">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="brickWeavePlungeFeedrate">Plunge Feedrate</label>
        <div class="controls">
            <input id="brickWeavePlungeFeedrate" type="number" step="1" min="0" value="200">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="brickWeavePullOffDistance">Pull off distance</label>
        <div class="controls">
            <input id="brickWeavePullOffDistance" type="number" step="0.1" min="0" value="3">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="brickWeaveCutterHeadWidth">Cutter Head Width</label>
        <div class="controls">
            <input id="brickWeaveCutterHeadWidth" type="number" step="0.01" min="0" value="6.35">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label" for="brickWeaveLength">length of brickweave</label>
        <div class="controls">
            <input id="brickWeaveLength" type="number" step="0.1" min="0" value="25.4">
        </div>
    </div>

    <div class="control-group">
        <label class="control-label">Direction</label>
        <div class="controls">
            <label class="radio inline">
                <input type="radio" name="brickWeaveDirection" id="brickWeaveDirectionLR" value="LR" checked> L-R
            </label>
            <label class="radio inline">
                <input type="radio" name="brickWeaveDirection" id="brickWeaveDirectionRL" value="RL"> R-L
            </label>
        </div>
    </div>
</form>
